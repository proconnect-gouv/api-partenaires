{
  "name": "@proconnect-gouv/partners",
  "private": true,
  "packageManager": "bun@1.4.2",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun run format:check && bun run typecheck",
    "lint:apotropaic": "bun run scripts/apotropaic.ts",
    "lint:config": "bun run scripts/lint_config.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "dependencies": {
    "hono": "4.13.7",
    "mongodb": "7.6.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.2",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "7.0.2"
  }
}
