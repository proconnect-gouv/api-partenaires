{
  "name": "@proconnect-gouv/partners",
  "private": true,
  "packageManager": "bun@1.4.4",
  "imports": {
    "#src/*": "./src/*/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/api/bin/index.ts",
    "explain:domain": "bun run src/validation/bin/explain_domain.ts",
    "format": "NODE_OPTIONS=--max-old-space-size=8192 prettier --write .",
    "format:check": "NODE_OPTIONS=--max-old-space-size=8192 prettier --check .",
    "lint": "bun run format:check && bun run typecheck",
    "lint:apotropaic": "bun run src/validation/bin/apotropaic.ts",
    "lint:config": "bun run src/validation/bin/lint_config.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "release-it": {
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@csmith/release-it-calver-plugin": {
        "cycle": "month"
      }
    }
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "dependencies": {
    "@proconnect-gouv/proconnect.core": "^1.1.1",
    "hono": "4.13.14",
    "mongodb": "7.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.4",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "7.0.2"
  },
  "version": "2026.11.0"
}
